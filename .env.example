# ==========================================================
# ⚠️  环境变量模板（可安全提交到 git）
#   用法：在【服务器】上执行  cp .env.example .env
#        然后编辑 .env，把下面的 CHANGE_ME 全部换成真实值。
# ==========================================================

# ===================== 必填配置（必须修改） =====================
# JWT 签名密钥（≥32字符，用随机值，例如：openssl rand -hex 48）
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS_RANDOM

# MySQL root 密码（请设置强密码，不要复用其他环境的值）
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# 应用数据库用户密码（与 root 区分，最小权限）
MYSQL_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# 首次启动管理员密码（用于创建默认管理员账号）
DEFAULT_ADMIN_USERNAME=CHANGE_ME_ADMIN
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Redis 密码（强密码；留空则 Redis 不启用认证）
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# 锚定库专用密码（仅 INSERT + SELECT 权限，独立账号）
ANCHOR_MYSQL_USER=CHANGE_ME_ANCHOR_USER
ANCHOR_MYSQL_PASSWORD=CHANGE_ME_ANCHOR_PASSWORD

# ===================== 域名 / SSL（生产必改） =====================
# 你的正式域名（将用于签发 Let's Encrypt 证书与 nginx）
NGINX_HOST=peom.win
# 证书注册/续期通知邮箱
LETSENCRYPT_EMAIL=CHANGE_ME_YOUR_EMAIL@example.com

# CORS 允许的来源，生产应为你的域名（多个用逗号分隔）
CORS_ALLOWED_ORIGINS=https://CHANGE_ME_YOUR_DOMAIN

# ===================== 可选配置（通常保持默认） =====================
# JWT 过期时间（毫秒，默认 24 小时）
JWT_EXPIRATION_MS=86400000

# 数据库名称（默认 food_traceability，一般不用改）
MYSQL_DATABASE=food_traceability
# 应用数据库用户（默认 app_user，建议固定）
MYSQL_USER=app_user

# 锚定库名（默认 food_traceability_anchor）
ANCHOR_MYSQL_DATABASE=food_traceability_anchor

# Hibernate DDL 策略（生产建议 validate，开发可用 update）
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ===================== 区块链（保持默认即可） =====================
# RSA 密钥文件路径（容器内路径，由 backend/keys 挂载，bootstrap 自动生成）
BLOCKCHAIN_RSA_PRIVATE_KEY=/app/keys/private.pem
BLOCKCHAIN_RSA_PUBLIC_KEY=/app/keys/public.pem

# ===================== 共识配置（gRPC PBFT，默认单机非分布式） =====================
# 单机单节点部署请保持 false，勿改动以下字段
CONSENSUS_GRPC_ENABLED=false
CONSENSUS_GRPC_SERVER_START=false
CONSENSUS_AGENT_ID=ca-agent-0
CONSENSUS_AGENT_ROLE=PRIMARY
CONSENSUS_GRPC_PORT=50051
CONSENSUS_PEER0_HOST=peer-0
CONSENSUS_PEER0_PORT=50051
CONSENSUS_PEER1_HOST=peer-1
CONSENSUS_PEER1_PORT=50052
CONSENSUS_PEER2_HOST=peer-2
CONSENSUS_PEER2_PORT=50053
CONSENSUS_PEER3_HOST=peer-3
CONSENSUS_PEER3_PORT=50054

# ===================== 前端暴露端口 =====================
# 若用 docker-compose.prod.yml（edge 443 终结），80 端口由 edge 占用，此项保持 80
FRONTEND_EXPOSED_PORT=80
