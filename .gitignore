# ==============================================
# 🔒 安全级：绝对不能提交的敏感文件（必须保留）
# ==============================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local
*.pem
*.key
*.keystore
*.jks
*.pfx
*.p12
application-secret.yml
application-secret.properties
secrets/
secrets.*
config/secret/

# SSL 证书
**/*.crt
**/*.cert
**/*.cer


# ==============================================
# 📦 构建产物：自动生成，无需提交
# ==============================================
# Spring Boot
**/target/
**/build/
**/mvnw.cmd
**/mvnw
!.mvn/wrapper/maven-wrapper.jar

# 前端
frontend/node_modules/
